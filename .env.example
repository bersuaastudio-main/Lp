# ─────────────────────────────────────────────────────────────────────────────
# Bersua LP — environment variables
# Salin file ini jadi .env.local (lokal) atau isi di dashboard hosting (produksi).
# Semua opsional: tanpa nilai, script analytics TIDAK dirender sama sekali.
# ─────────────────────────────────────────────────────────────────────────────

# Google Analytics 4 — Measurement ID dari Admin → Data Streams
# Contoh: G-ABC1234567
NEXT_PUBLIC_GA_ID=

# Microsoft Clarity — Project ID dari Settings → Overview
# Contoh: abcd1234ef
NEXT_PUBLIC_CLARITY_ID=

# Catatan: prefix NEXT_PUBLIC_ berarti nilai ini TERLIHAT di browser.
# Jangan pernah menaruh API key rahasia, kredensial database, atau token
# dengan prefix NEXT_PUBLIC_.
